# ---------------------------------------------------------------------------
# How to use this file
# ---------------------------------------------------------------------------
# Local:  copy it to `.env.local` and fill it in (`.env*` is gitignored).
#         `next dev` reloads the file on save; no restart needed.
# Vercel: this file is never read there. Set the same variables under
#         Project -> Settings -> Environment Variables, then REDEPLOY —
#         env changes do not reach deployments that already exist.
#         The dashboard's "Import .env" accepts a pasted `.env.local`.

# ---------------------------------------------------------------------------
# Contact form (Server Action -> Resend)      lib/actions/contact.ts
# ---------------------------------------------------------------------------

# REQUIRED — https://resend.com/api-keys, starts with `re_`.
# Without it the form still validates, but tells the visitor that delivery is
# not configured yet, and the message is lost: nothing is stored anywhere.
RESEND_API_KEY=

# REQUIRED in practice. Falls back to `Portfolio <onboarding@resend.dev>`,
# Resend's shared sender, which only delivers to the inbox that owns the Resend
# account — everyone else gets a 403 and the visitor sees a generic error:
#
#   You can only send testing emails to your own email address (...).
#
# Sending anywhere else means verifying a domain at https://resend.com/domains
# and using an address on it. The local part is arbitrary — no mailbox has to
# exist. Production uses:  Portfolio <contacto@avisos.vindo.com.mx>
#
# Deliverability: verifying the domain publishes SPF and DKIM, but Resend does
# not ask for DMARC and Outlook leans on it hard for domains it has never seen.
# Add a TXT record at `_dmarc.<your-domain>` with `v=DMARC1; p=none;` or expect
# the first messages to land in junk.
CONTACT_FROM_EMAIL=

# Optional — the inbox that receives the messages. Defaults to `site.email` in
# content/site.ts, so the address advertised on the site and the one collecting
# the mail stay the same. Set this only to split them apart.
CONTACT_TO_EMAIL=

# ---------------------------------------------------------------------------
# Canonical URL (optional)
# ---------------------------------------------------------------------------
# Only needed when you point a custom domain at the project. On Vercel the
# production URL is detected automatically.
NEXT_PUBLIC_SITE_URL=
